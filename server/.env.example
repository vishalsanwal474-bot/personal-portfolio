PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Production tip: when frontend + API are on the same Render service, use:
# CLIENT_ORIGIN=*

# AI provider (OpenAI-compatible). Leave empty for local fallback answers.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1

# Private admin panel — required to edit content from /#admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
